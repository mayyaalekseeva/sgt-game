{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "barista-game",
  "compatibility_date": "2026-10-26",
  "main": "./worker/index.ts",
  "upload_source_maps": true,
  // The Vite plugin fills in assets.directory with the client build output.
  // Hash routing only ever requests /, so no SPA fallback: unknown paths 404.
  "assets": {
    "run_worker_first": ["/api/*"]
  },
  // Workers Builds runs `wrangler preview` (open beta) for non-production branches, including PR
  // branches, and it fails without this block. Empty: previews use the defaults.
  "previews": {},
  // Google OAuth client (Web application). Locally in .dev.vars (see .dev.vars.example),
  // in production via `wrangler secret put GOOGLE_CLIENT_ID` / `GOOGLE_CLIENT_SECRET`.
  "secrets": {
    "required": ["GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"]
  },
  // Schema in worker/db/schema.ts, SQL generated by drizzle-kit into migrations/, applied by wrangler.
  // Before the first remote deploy: `wrangler d1 create barista-game` and add its database_id here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "barista-game",
      "migrations_dir": "migrations"
    }
  ],
  // Report photos (worker/photos.ts). Private: served only through /api/reports/:id/photo/:nonce to the owner.
  // Before the first deploy that needs it: create the bucket (README, "Before merging").
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "barista-photos"
    }
  ]
}
