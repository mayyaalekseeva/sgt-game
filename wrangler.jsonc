{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "barista-game",
  "compatibility_date": "2026-10-26",
  "main": "./worker/index.ts",
  "upload_source_maps": true,
  // The Vite plugin fills in assets.directory with the client build output.
  // Hash routing only ever requests /, so no SPA fallback: unknown paths 404.
  "assets": {
    "run_worker_first": ["/api/*"]
  },
  // Schema in worker/db/schema.ts, SQL generated by drizzle-kit into migrations/, applied by wrangler.
  // Before the first remote deploy: `wrangler d1 create barista-game` and add its database_id here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "barista-game",
      "migrations_dir": "migrations"
    }
  ]
}
