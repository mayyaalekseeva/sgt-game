# Cloudflare Pages headers. Copied to dist/ by Vite (public/).
# Rules that match the same path stack, and duplicate headers get joined,
# so Cache-Control is only set in rules that never overlap.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Vite output, content-hashed file names: safe to cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Brand images keep their names, so cache them briefly and revalidate
/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Lot photos, copied from the roaster shop (npm run lots:photos)
/lots/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The app shell must always be fresh so new hashed assets get picked up
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
